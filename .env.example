# EARTHWORM Agritech Platform - Environment Configuration Template
# Copy this file to .env and configure your production API credentials

# Supabase Configuration (Get from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Google Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Open Government Data (Data.gov.in) API Key (from https://data.gov.in/)
DATA_GOV_API_KEY=your_data_gov_api_key_here
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Node Environment
NODE_ENV=production
